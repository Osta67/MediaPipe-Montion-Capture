<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FitRise Alarm</title>
    <style>
        body { background: #121212; color: #00ff88; font-family: 'Arial', sans-serif; text-align: center; padding-top: 100px; }
        #clock { font-size: 5rem; font-weight: bold; margin-bottom: 20px; }
        input[type="time"] { font-size: 1.5rem; padding: 10px; border-radius: 8px; border: none; }
        button { background: #00ff88; color: #121212; border: none; padding: 15px 30px; font-size: 1.2rem; border-radius: 8px; cursor: pointer; margin-top: 20px; }
        button:hover { background: #00cc6e; }
    </style>
</head>
<body>

    <h1>FitRise: Wake Up & Move</h1>
    <div id="clock">00:00:00</div>
    <input type="time" id="alarmTime">
    <br>
    <button onclick="saveAlarm()">Set Morning Alarm</button>

    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-app.js";
        import { getFirestore, doc, setDoc } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-firestore.js";

        // REPLACE THE DATA BELOW WITH YOUR PROJECT SETTINGS FROM FIREBASE CONSOLE
        const firebaseConfig = {
            apiKey: "YOUR_API_KEY",
            authDomain: "YOUR_PROJECT.firebaseapp.com",
            projectId: "YOUR_PROJECT_ID",
            storageBucket: "YOUR_PROJECT.appspot.com",
            messagingSenderId: "YOUR_ID",
            appId: "YOUR_APP_ID"
        };

        const app = initializeApp(firebaseConfig);
        const db = getFirestore(app);

        // Update Clock
        setInterval(() => {
            const now = new Date();
            const timeString = now.toLocaleTimeString('en-GB', { hour12: false });
            document.getElementById('clock').innerText = timeString;

            const targetTime = localStorage.getItem('userAlarm');
            if (targetTime && timeString.startsWith(targetTime)) {
                triggerAlarm();
            }
        }, 1000);

        window.saveAlarm = async function() {
            const time = document.getElementById('alarmTime').value;
            localStorage.setItem('userAlarm', time);
            alert("Alarm saved for " + time);
        }

        async function triggerAlarm() {
            // Signal to Firebase that the alarm is active
            await setDoc(doc(db, "alarms", "status"), { isTriggered: true });
            
            // REDIRECT: Change this to YOUR Streamlit URL
            window.location.href = "https://your-app-name.streamlit.app";
        }
    </script>
</body>
</html>
